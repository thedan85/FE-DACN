# Public: accessible by browser code
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# Public: Google OAuth Web client ID. Must equal the backend GOOGLE_CLIENT_ID.
# Authorized JavaScript origin: http://localhost:3000
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Public: Supabase project URL and publishable key for Realtime Broadcast only.
# Both or neither. The signing key stays backend-only.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key