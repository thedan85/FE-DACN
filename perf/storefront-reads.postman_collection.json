{
  "info": {
    "name": "Aquarium Store — Storefront read workload",
    "description": "Representative public GET requests issued by the storefront home, catalog, search, and product-detail pages. Used for API performance baselines. All requests are read-only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080/api/v1" },
    { "key": "slug", "value": "anubias-nana-petite" },
    { "key": "categoryId", "value": "epiphyte" }
  ],
  "item": [
    {
      "name": "1. Catalog list (products?size=20)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products?size=20&page=0", "host": ["{{baseUrl}}"], "path": ["products"], "query": [ {"key":"size","value":"20"}, {"key":"page","value":"0"} ] }
      }
    },
    {
      "name": "2. Search by name (products/search?name=anubias)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/search?name=anubias&size=20", "host": ["{{baseUrl}}"], "path": ["products","search"], "query": [ {"key":"name","value":"anubias"}, {"key":"size","value":"20"} ] }
      }
    },
    {
      "name": "3. Product detail (products/{slug})",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/{{slug}}", "host": ["{{baseUrl}}"], "path": ["products","{{slug}}"] }
      }
    },
    {
      "name": "4. Product variants (products/{slug}/variants)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/{{slug}}/variants", "host": ["{{baseUrl}}"], "path": ["products","{{slug}}","variants"] }
      }
    },
    {
      "name": "5. Product media (products/{slug}/media)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/{{slug}}/media", "host": ["{{baseUrl}}"], "path": ["products","{{slug}}","media"] }
      }
    },
    {
      "name": "6. Product attributes (products/{slug}/attributes)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/products/{{slug}}/attributes", "host": ["{{baseUrl}}"], "path": ["products","{{slug}}","attributes"] }
      }
    },
    {
      "name": "7. Categories (categories)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/categories", "host": ["{{baseUrl}}"], "path": ["categories"] }
      }
    },
    {
      "name": "8. Variants list (variants)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/variants", "host": ["{{baseUrl}}"], "path": ["variants"] }
      }
    },
    {
      "name": "9. Media list (media)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/media", "host": ["{{baseUrl}}"], "path": ["media"] }
      }
    },
    {
      "name": "10. Health (health/redis)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/health/redis", "host": ["{{baseUrl}}"], "path": ["health","redis"] }
      }
    }
  ]
}
