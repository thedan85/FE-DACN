#!/bin/sh
# Local guardrail: block a commit that breaks lint, types, a CSS-module reference,
# the file encoding, or an antd v6 API.
# Enable once per clone:  git config core.hooksPath .githooks
# Bypass for a known-good emergency only:  git commit --no-verify
set -e

staged=$(git diff --cached --name-only --diff-filter=ACMR -- '*.ts' '*.tsx' '*.js' '*.jsx' '*.mjs')

if [ -z "$staged" ]; then
	exit 0
fi

echo "pre-commit: checking staged source files"

npm run --silent check:css

# Whole-tree and byte-level, so it also catches a file this commit did not touch.
npm run --silent check:encoding

# The CLI exits 0 whether or not it finds anything; scripts/lint-antd.mjs turns
# its findings into an exit code.
npm run --silent lint:antd -- --staged

# Lint only what is being committed; the full lint runs in `npm run check`.
echo "$staged" | tr '\n' '\0' | xargs -0 npx --no-install eslint

npm run --silent typecheck

npm run --silent test

echo "pre-commit: ok"
